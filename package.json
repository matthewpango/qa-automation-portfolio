{
  "name": "parcelquote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/quote.test.ts tests/routes.test.ts",
    "test:integration": "node --test tests/app.test.ts",
    "test:api": "allure run -- playwright test --project=api",
    "test:ui": "allure run -- playwright test --project=chromium",
    "test:playwright": "allure run -- playwright test",
    "allure:open": "allure serve --host 0.0.0.0 --port 8080",
    "check": "npm run typecheck && npm run test:unit && npm run test:integration",
    "test": "npm run check && npm run test:playwright"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "overrides": {
    "glob": "14.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "allure": "3.33.0",
    "allure-playwright": "3.14.0",
    "typescript": "^7.0.2"
  }
}
