{
  "name": "parcelquote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/quote.test.ts tests/api.test.ts tests/routes.test.ts",
    "test:ui": "playwright test",
    "check": "npm run typecheck && npm run test:unit",
    "test": "npm run check && npm run test:ui"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
